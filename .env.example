# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_VERSION=0.1.0
SECRET_KEY=change-me-in-production
VALID_API_KEYS=dev-key-1,dev-key-2

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/autoinsight

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── LLM API Keys ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── AWS / S3 ─────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=autoinsight-dev

# ── Observability ─────────────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=autoinsight-dev
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Vector Store ─────────────────────────────────────────────────────────────
# dev: chroma (local)  |  prod: databricks
VECTOR_STORE_BACKEND=chroma
CHROMA_PERSIST_DIR=./chroma_db

# Databricks (prod only)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_VSS_INDEX=autoinsight_knowledge_base

# ── Code Execution Sandbox ────────────────────────────────────────────────────
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=512
