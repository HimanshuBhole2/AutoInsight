# Copy this file to .env and fill in your values before running anything.
# cp .env.example .env

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development               # development | staging | production
APP_VERSION=0.1.0                 # reported in GET /
SECRET_KEY=change-me-in-production  # used for signing; set a long random string in prod
VALID_API_KEYS=dev-key-1,dev-key-2  # comma-separated; sent as X-API-Key header

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/autoinsight

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0          # general redis connection
CELERY_BROKER_URL=redis://localhost:6379/0  # task queue
CELERY_RESULT_BACKEND=redis://localhost:6379/1  # job results stored here

# ── LLM API Keys ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...             # required: used for goal parsing, planning, code gen
ANTHROPIC_API_KEY=sk-ant-...      # required: used for self-critic and narrative writing

# ── AWS / S3 ─────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=                # leave blank for local dev
AWS_SECRET_ACCESS_KEY=            # leave blank for local dev
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=autoinsight-dev         # bucket for datasets, charts, reports

# ── LangSmith (observability) ────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false        # set true to enable LangSmith traces
LANGCHAIN_API_KEY=ls__...         # get from smith.langchain.com
LANGCHAIN_PROJECT=autoinsight-dev # groups traces by project in LangSmith UI

# ── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000  # local MLflow server (make mlflow)

# ── Vector Store ─────────────────────────────────────────────────────────────
VECTOR_STORE_BACKEND=chroma       # chroma (local dev) | databricks (prod)
CHROMA_PERSIST_DIR=./chroma_db    # local directory for Chroma embeddings

# Databricks VSS (prod only — leave blank for local dev)
DATABRICKS_HOST=                  # e.g. https://adb-xxxx.azuredatabricks.net
DATABRICKS_TOKEN=                 # personal access token from Databricks UI
DATABRICKS_VSS_INDEX=autoinsight_knowledge_base  # vector search index name

# ── Code Execution Sandbox ────────────────────────────────────────────────────
SANDBOX_TIMEOUT_SECONDS=30        # kill generated code after this many seconds
SANDBOX_MAX_MEMORY_MB=512         # memory cap for sandboxed subprocess
